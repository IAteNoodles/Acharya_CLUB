# ── Application ──────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_NAME=Acharya_CLUB
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ── Database (Supabase) ──────────────────────────────
# Either set DATABASE_URL directly, or set DB_PASSWORD to construct it:
DATABASE_URL=postgresql+asyncpg://postgres:localdev@localhost:5432/acharya
# DB_PASSWORD=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=3

# ── Redis / Upstash ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── JWT ──────────────────────────────────────────────
# Not needed in development — auto-generated on startup if absent.
# In production, set a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
