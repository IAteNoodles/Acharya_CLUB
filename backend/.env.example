# ── Application ──────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_NAME=Acharya_CLUB
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────
# Optional: Override the default local SQLite database
# DATABASE_URL=sqlite+aiosqlite:///./acharya_club.db

# ── JWT ──────────────────────────────────────────────
# Not needed in development — auto-generated on startup if absent.
# In production, set a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
